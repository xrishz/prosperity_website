  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Bold rounded primary action, with semantic light/dark colors and a small hover lift.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Plan your trip <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:50px;padding:14px 23px;border:1px solid transparent;border-radius:12px;background:var(--primary);color:var(--primary-foreground);font-family:var(--font-manrope,Manrope),sans-serif;font-size:.9rem;font-weight:750;line-height:1.4;transition:background .2s,transform .2s;white-space:nowrap;cursor:pointer}.ds-button-primary:hover:where(:not(:disabled):not([aria-disabled=\"true\"])){transform:translateY(-2px);background:var(--primary-hover);color:var(--primary-foreground)}.ds-button-primary:active:not(:disabled):not([aria-disabled=\"true\"]){transform:translateY(0)}.ds-button-primary:focus-visible{outline:3px solid var(--focus-ring);outline-offset:3px;box-shadow:0 0 0 3px var(--focus-contrast)}.ds-button-primary:disabled,.ds-button-primary[aria-disabled=\"true\"]{opacity:1;background:var(--disabled-background);color:var(--disabled-foreground);border-color:var(--border-strong);transform:none;cursor:not-allowed}.ds-button-primary[aria-busy=\"true\"]{cursor:progress}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}.ds-button-primary:hover{transform:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bold rounded outlined action, filling with the subtle surface on hover.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Copy inquiry <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:50px;padding:14px 23px;border:1px solid var(--border-strong);border-radius:12px;background:transparent;color:var(--secondary-foreground);font-family:var(--font-manrope,Manrope),sans-serif;font-size:.9rem;font-weight:750;line-height:1.4;transition:background .2s,transform .2s;white-space:nowrap;cursor:pointer}.ds-button-secondary:hover:where(:not(:disabled):not([aria-disabled=\"true\"])){transform:translateY(-2px);background:var(--secondary);color:var(--secondary-foreground)}.ds-button-secondary:active:not(:disabled):not([aria-disabled=\"true\"]){transform:translateY(0)}.ds-button-secondary:focus-visible{outline:3px solid var(--focus-ring);outline-offset:3px;box-shadow:0 0 0 3px var(--focus-contrast)}.ds-button-secondary:disabled,.ds-button-secondary[aria-disabled=\"true\"]{opacity:1;background:var(--disabled-background);color:var(--disabled-foreground);border-color:var(--border-strong);transform:none;cursor:not-allowed}.ds-button-secondary[aria-busy=\"true\"]{cursor:progress}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}.ds-button-secondary:hover{transform:none}}"
    },
    {
      "name": "Appearance",
      "kind": "button",
      "refersTo": "appearance-toggle",
      "description": "Two state examples of the single sun/moon appearance button. Production shows the current resolved icon and persists the opposite explicit appearance when activated; the preview demonstrates its control states without a provider runtime.",
      "html": "<button type=\"button\" class=\"ds-theme-toggle\" aria-label=\"Switch to dark theme (currently light)\" title=\"Appearance: System (light). Switch to dark.\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0\"/><path d=\"M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7\"/></svg></button> <button type=\"button\" class=\"ds-theme-toggle\" aria-label=\"Switch to light theme (currently dark)\" title=\"Appearance: dark. Switch to light.\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008\"/></svg></button>",
      "css": ".ds-theme-toggle{width:48px;height:48px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:1px solid transparent;color:var(--foreground);border-radius:50%;transition:background .2s;cursor:pointer}.ds-theme-toggle:hover:not(:disabled){color:var(--primary);background:var(--surface-subtle)}.ds-theme-toggle:active:not(:disabled){background:var(--surface-subtle)}.ds-theme-toggle:focus-visible{outline:3px solid var(--focus-ring);outline-offset:3px;box-shadow:0 0 0 3px var(--focus-contrast)}.ds-theme-toggle:disabled{opacity:1;background:var(--disabled-background);color:var(--disabled-foreground);border-color:var(--border-strong);transform:none;cursor:not-allowed}.ds-theme-toggle:disabled svg{visibility:hidden}"
    },
    {
      "name": "Navigation Links",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Compact desktop navigation with a bold current label and two-pixel rule; larger stacked mobile links.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Main navigation\"><a class=\"ds-navigation-link\" href=\"#home\" aria-current=\"page\">Home</a><a class=\"ds-navigation-link\" href=\"#destinations\">Destinations</a><a class=\"ds-navigation-link\" href=\"#services\">Services</a></nav>",
      "css": ".ds-navigation{display:flex;gap:30px;align-items:center;min-height:80px;background:var(--header-background);color:var(--foreground);font-family:var(--font-manrope,Manrope),sans-serif;line-height:1.65}.ds-navigation-link{font-size:.85rem;min-height:44px;display:flex;align-items:center;border-bottom:2px solid transparent;color:inherit;text-decoration:none}.ds-navigation-link[aria-current]{border-bottom-color:var(--primary);font-weight:700}.ds-navigation-link:hover{text-decoration-color:currentColor;color:var(--link-hover)}.ds-navigation-link:focus-visible{outline:3px solid var(--focus-ring);outline-offset:3px;box-shadow:0 0 0 3px var(--focus-contrast)}@media(max-width:1100px){.ds-navigation{gap:18px}}@media(max-width:800px){.ds-navigation{display:block;padding:24px 28px}.ds-navigation-link{justify-content:space-between;padding-block:15px;font-size:1.7rem;border-bottom:0}.ds-navigation-link[aria-current]{text-decoration:underline;text-underline-offset:8px}}@media(min-width:801px) and (max-width:980px){.ds-navigation{gap:12px}.ds-navigation-link{font-size:.78rem}}"
    },
    {
      "name": "Inquiry Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Externally labeled inquiry field with appearance-aware surface, visible focus and text-supported validation.",
      "html": "<div class=\"ds-inquiry-field\"><label class=\"ds-field-label\" for=\"ds-destination\">Destination <span class=\"ds-field-optional\">optional</span></label><input class=\"ds-field-input\" id=\"ds-destination\" type=\"text\" placeholder=\"e.g. Japan\" aria-describedby=\"ds-destination-help\"><p class=\"ds-field-help\" id=\"ds-destination-help\">Share a destination you have in mind.</p></div>",
      "css": ".ds-inquiry-field{min-width:0;font-family:var(--font-manrope,Manrope),sans-serif;line-height:1.65}.ds-field-label{display:block;color:var(--foreground);font-size:.95rem;font-weight:650;margin-bottom:.6rem}.ds-field-optional{margin-left:.35rem;font-weight:400;font-size:.8rem;color:var(--muted-foreground)}.ds-field-input{display:block;width:100%;min-height:50px;padding:.85rem 1rem;border:1px solid var(--border-strong);border-radius:5px;color:var(--foreground);background:var(--input-background);font:inherit;font-size:1rem;caret-color:var(--primary);transition:border-color .15s,box-shadow .15s}.ds-field-input::placeholder{color:var(--muted-foreground);opacity:1}.ds-field-input:focus-visible{border-color:var(--primary);outline:3px solid var(--focus-ring);outline-offset:3px;box-shadow:0 0 0 3px var(--focus-contrast)}.ds-field-input[aria-invalid=\"true\"]{border-color:var(--danger)}.ds-field-input:disabled{opacity:1;color:var(--disabled-foreground);background:var(--disabled-background);border-color:var(--border-strong);cursor:not-allowed}.ds-field-help{margin:.55rem 0 0;color:var(--muted-foreground);font-size:.84rem;line-height:1.65}.ds-field-error{margin:.55rem 0 0;color:var(--danger);font-size:.84rem;line-height:1.6}@media(prefers-reduced-motion:reduce){.ds-field-input{transition:none}}.ds-field-input[aria-invalid=\"true\"],.ds-field-input[aria-invalid=\"true\"]:hover{border-color:var(--danger)}.ds-field-input:-webkit-autofill{-webkit-text-fill-color:var(--foreground);caret-color:var(--primary);-webkit-box-shadow:0 0 0 1000px var(--input-background) inset}.ds-field-input:-webkit-autofill:focus-visible{-webkit-box-shadow:0 0 0 1000px var(--input-background) inset,0 0 0 3px var(--focus-contrast)}"
    },
    {
      "name": "Country Picker",
      "kind": "chip",
      "refersTo": "country-picker",
      "description": "Sky-region choices with sunshine-yellow pressed state. The preview shows static selected and unselected states.",
      "html": "<fieldset class=\"ds-country-picker\"><legend>Where would you love to go?</legend><div><button type=\"button\" aria-pressed=\"false\">Japan</button><button type=\"button\" aria-pressed=\"true\">Greece</button><button type=\"button\" aria-pressed=\"false\">Dubai</button></div></fieldset>",
      "css": ".ds-country-picker{border:0;padding:20px;margin:0;min-width:0;background:var(--atlas-sky,#8edcf4);color:var(--atlas-sky-ink,#0b3734);font-family:var(--font-manrope,Manrope),sans-serif;--focus-ring:var(--atlas-sky-ink,#0b3734);--focus-contrast:var(--atlas-sky,#8edcf4)}.ds-country-picker legend{font-size:.85rem;font-weight:700;padding:0;margin-bottom:12px}.ds-country-picker>div{display:flex;flex-wrap:wrap;gap:8px}.ds-country-picker button{min-height:44px;border:1px solid currentColor;border-radius:10px;padding:8px 13px;font-family:inherit;font-size:.8rem;font-weight:750;background:transparent;color:var(--atlas-sky-ink,#0b3734);transition:background .2s;cursor:pointer}.ds-country-picker button:hover{background:var(--atlas-picker-hover,#f6fcff4d)}.ds-country-picker button[aria-pressed=\"true\"]{border-color:var(--atlas-yellow,#ffd34f);background:var(--atlas-yellow,#ffd34f);color:var(--atlas-yellow-ink,#0b3734)}.ds-country-picker button:focus-visible{outline:3px solid var(--focus-ring,#0b3734);outline-offset:3px;box-shadow:0 0 0 3px var(--focus-contrast,#fffefa)}@media(prefers-reduced-motion:reduce){.ds-country-picker button{transition:none}}"
    },
    {
      "name": "Photo Filters",
      "kind": "chip",
      "refersTo": "gallery-filter",
      "description": "Wrapped destination filters with a primary pressed state and polite photo count. Static preview states require no application runtime.",
      "html": "<div class=\"ds-photo-filters\" role=\"group\" aria-label=\"Filter destination photos\"><button type=\"button\" aria-pressed=\"true\">All places</button><button type=\"button\" aria-pressed=\"false\">Japan</button><button type=\"button\" aria-pressed=\"false\">Greece</button></div><p class=\"ds-photo-count\" role=\"status\">Destination inspiration</p>",
      "css": ".ds-photo-filters{display:flex;flex-wrap:wrap;gap:10px;font-family:var(--font-manrope,Manrope),sans-serif}.ds-photo-filters button{color:var(--foreground,#182b26);background:transparent;border:1px solid var(--border-strong,#7a887e);border-radius:12px;padding:10px 18px;min-height:44px;font-family:inherit;font-size:.85rem;font-weight:700;cursor:pointer}.ds-photo-filters button:hover{background:var(--surface-subtle,#dbefe9)}.ds-photo-filters button[aria-pressed=\"true\"]{background:var(--primary,#0b3734);border-color:var(--primary,#0b3734);color:var(--primary-foreground,#fffefa)}.ds-photo-filters button:focus-visible{outline:3px solid var(--focus-ring,#0b3734);outline-offset:3px;box-shadow:0 0 0 3px var(--focus-contrast,#fffefa)}.ds-photo-count{margin:16px 0 28px;color:var(--muted-foreground,#52635c);font-family:var(--font-manrope,Manrope),sans-serif;font-size:.78rem;line-height:1.65}"
    },
    {
      "name": "Gallery Photograph",
      "kind": "card",
      "refersTo": "gallery-photo",
      "description": "Rounded cover-crop window with bold country caption and an underlined destination link. Labeled asset-free placeholder demonstrates geometry; production uses real photography.",
      "html": "<figure class=\"ds-gallery-photo\"><div class=\"ds-gallery-image\"><svg viewBox=\"0 0 600 400\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"Destination photograph placeholder\"><rect width=\"600\" height=\"400\" fill=\"var(--surface-subtle,#dbefe9)\"/><text x=\"300\" y=\"200\" text-anchor=\"middle\" fill=\"var(--muted-foreground,#52635c)\" font-family=\"sans-serif\" font-size=\"20\">Destination photograph</text></svg></div><figcaption class=\"ds-gallery-caption\"><div><span>Greece</span><p>Destination inspiration</p></div><a class=\"ds-gallery-link\" href=\"#greece\">Explore Greece <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a></figcaption></figure>",
      "css": ".ds-gallery-photo{margin:0;max-width:600px;min-width:0;color:var(--foreground,#182b26);font-family:var(--font-manrope,Manrope),sans-serif;line-height:1.65}.ds-gallery-image{position:relative;aspect-ratio:1.5;overflow:hidden;border-radius:24px;background:var(--surface-subtle,#dbefe9)}.ds-gallery-image>svg{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.16,1,.3,1)}.ds-gallery-photo:hover .ds-gallery-image>svg{transform:scale(1.035)}.ds-gallery-caption{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding-top:17px}.ds-gallery-caption>div{min-width:0}.ds-gallery-caption span{font-size:1.2rem;font-weight:800}.ds-gallery-caption p{color:var(--muted-foreground,#52635c);font-size:.83rem;margin:4px 0 0}.ds-gallery-link{display:inline-flex;align-items:center;gap:10px;min-height:44px;flex-shrink:0;font-size:.76rem;font-weight:650;color:inherit;text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:1px}.ds-gallery-link:hover{color:var(--link-hover,#705823)}.ds-gallery-link:focus-visible{outline:3px solid var(--focus-ring,#0b3734);outline-offset:3px;box-shadow:0 0 0 3px var(--focus-contrast,#fffefa)}@media(max-width:800px){.ds-gallery-image{aspect-ratio:1.4;border-radius:20px}.ds-gallery-caption{gap:12px}.ds-gallery-caption span{font-size:1.1rem}.ds-gallery-link{font-size:.7rem;max-width:110px}}@media(max-width:350px){.ds-gallery-caption{display:block}.ds-gallery-link{max-width:none}}@media(prefers-reduced-motion:reduce){.ds-gallery-image>svg{transition:none}.ds-gallery-photo:hover .ds-gallery-image>svg{transform:none}}"
    }
  ],
  "narrative": {
    "northStar": "3D Travel Atlas",
    "overview": "A lively 3D Travel Atlas pairs sky-blue and sunshine-yellow regions with evergreen controls, rounded photographs and softly lit cartoon transport. Real landscapes and real people provide the visual substance; aircraft, a service coach, clouds and perspective destination cards create an inviting travel atmosphere. Low-contrast cross marks and soft section gradients connect the regions without competing with their copy.\n\nManrope carries a confident, friendly voice through heavy headings, compact controls and clear body text. Photo windows overlap, lean and lift where the composition calls for it. Practical navigation and inquiry fields keep simpler geometry. The transparent original oval identity remains visible within the colorful world.",
    "keyCharacteristics": [
      "Sky-blue, sunshine-yellow and evergreen regions with paired readable ink.",
      "Heavy Manrope headings and clear compact controls.",
      "Real photographs in generously rounded windows, with restrained tilt and soft depth.",
      "Cartoon dimensional transport, cross marks and soft section gradients.",
      "Finite transitions, direct carousel controls and a shared motion preference."
    ],
    "rules": [
      {
        "name": "The Role Continuity Rule",
        "body": "Use semantic appearance roles for ordinary controls and text. Keep sky and yellow regions on their paired ink roles, and preserve fixed brand and photograph contrast roles across light and dark appearances.",
        "section": "colors"
      },
      {
        "name": "The Image Evidence Rule",
        "body": "Use photographs for places and people; keep cartoon aircraft, coaches, clouds and route marks decorative. Preserve the visual distinction between destination inspiration and genuine traveler or team photography.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use Manrope throughout. Establish hierarchy with size, weight and spacing; keep display headings confident and controls compact.",
        "section": "typography"
      },
      {
        "name": "The Shared Edge Rule",
        "body": "Align ordinary content to the shared container. Let photo rails extend intentionally while preserving normal vertical scrolling and visible controls.",
        "section": "layout"
      },
      {
        "name": "The Tactile Depth Rule",
        "body": "Use soft directional shadows for overlapping photograph windows and dimensional travel artwork. Keep ordinary copy, lists and inquiry fields grounded on their section surface.",
        "section": "elevation"
      },
      {
        "name": "The Motion Permission Rule",
        "body": "Treat arrival and selection transitions as finite events. Pause ambient motion when requested, when reduced motion applies, or when the scene cannot be seen; keep all destinations and inquiry actions usable without animation.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use the paired sky or yellow ink token on expressive section backgrounds.",
      "**Do** keep the original logo transparent and preserve fixed brand and photograph contrast roles.",
      "**Do** use real destination, traveler and team photographs with deliberate cover crops and readable captions.",
      "**Do** carry rounded photo windows and heavier Manrope typography into new Atlas surfaces.",
      "**Do** keep visible focus, minimum touch height, manual carousel controls and a static motion alternative."
    ],
    "donts": [
      "**Don't** restore the superseded restrained ivory editorial world in new Atlas surfaces.",
      "**Don't** put decorative transport, clouds or cross marks over essential copy or controls.",
      "**Don't** recolor fixed media captions or brand assets through page appearance overrides.",
      "**Don't** turn every text block into a floating card or use photograph-window shadows on inquiry fields.",
      "**Don't** rely on dragging, color alone or animation to communicate the available action or selected state."
    ]
  }
}
