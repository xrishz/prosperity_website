      },
      {
        "name": "cursor-plane",
        "value": "drop-shadow(0 3px 4px rgb(2 34 31 / 28%))",
        "purpose": "Separation beneath the decorative airplane pointer."
      }
    ],
    "motion": [
      {
        "name": "arrival",
        "value": "2s ease-out",
        "purpose": "Finite initial aircraft arrival reveal."
      },
      {
        "name": "country-flight",
        "value": "1.5s; matched resting endpoints; concealed offscreen reposition",
        "purpose": "Destination departure and smooth return before photos reveal; repeated choices keep the running flight and reveal the latest selection."
      },
      {
        "name": "photo-reveal",
        "value": ".3s ease-out",
        "purpose": "Hero photograph opacity transition."
      },
      {
        "name": "photo-hover",
        "value": ".6s cubic-bezier(.16,1,.3,1)",
        "purpose": "Small gallery-image cover zoom."
      },
      {
        "name": "cloud-drift",
        "value": "14s ease-in-out infinite alternate",
        "purpose": "Ambient cloud movement when permitted."
      },
      {
        "name": "destination-depth",
        "value": "1000px perspective; center +64px; sides up to 56deg yaw; compact 900px/+36px/36deg",
        "purpose": "Centered photo cards project forward and sides recede, following Embla scroll events in one RAF. Manual mobile depth is retained; OS reduced motion uses flat cards. No destination bus or road."
      },
      {
        "name": "cursor-turn",
        "value": "220ms minimum; monotone Hermite ease in/out; 840deg/s maximum",
        "purpose": "Smooth displayed airplane heading, preserving velocity through same-direction turns without overshoot."
      },
      {
        "name": "cursor-tail",
        "value": "clamp(20px + filteredSpeed × 200, 20px, 320px); 60ms speed filter; neck min(16px, length × 0.6); 450ms stop fade",
        "purpose": "Connected ribbon length follows scalar traveled speed in px/ms independently of heading, retaining length through fast reversals. Filtered speed 0.025/0.15/0.5/1/≥1.5 px/ms yields 25/50/120/220/320px. The takeoff seed follows the current speed and the tail joins the displayed airplane angle exactly."
      }
    ],
